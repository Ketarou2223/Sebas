# ====== 必須 ======

# TMDB の API キー（v3 auth の API Key）
TMDB_API_KEY=

# LINE Messaging API のチャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Messaging API のチャネルシークレット（署名検証に使用）
LINE_CHANNEL_SECRET=


# ====== 任意 ======

# 設定すると /api/cron は Authorization: Bearer <CRON_SECRET> を要求する。
# Vercel Cron はこのヘッダを自動付与するため、設定しておくと外部からの実行を防げる。
CRON_SECRET=

# "false" にすると webhook の x-line-signature 検証をスキップする（デバッグ専用）。
# 本番では未設定 or "true" のままにすること。
VERIFY_SIGNATURE=

# Gemini（執事の文章生成基盤 lib/gemini.js が使用）。
# 現状はまだどの機能からも本格利用していないが、雑談などの機能を足すと必要になる。
GEMINI_API_KEY=

# 使用する Gemini モデル（未設定なら gemini-2.0-flash）。
GEMINI_MODEL=

# Upstash Redis（永続ストレージ基盤 lib/store.js が使用）。
# 両方揃ったときだけストアが有効になり、未設定なら store 操作は no-op になる。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
